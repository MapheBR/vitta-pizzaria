# Vitta Pizzaria Napolitana — Environment Variables
# Copie este arquivo para .env e preencha com os valores reais
# NUNCA commit o arquivo .env (já está no .gitignore)

# ============================================================================
# DATABASE
# ============================================================================
# Connection string para MySQL (Drizzle ORM)
# Formato: mysql://user:password@host:port/database
DATABASE_URL=mysql://user:password@localhost:3306/vitta

# ============================================================================
# AUTHENTICATION (Manus OAuth)
# ============================================================================
# ID do projeto Manus
MANUS_PROJECT_ID=your-project-id

# Secret para assinar JWT tokens (gerar string aleatória forte)
MANUS_JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# URL do servidor OAuth Manus
MANUS_OAUTH_API_URL=https://oauth.manus.com

# OpenID do usuário owner (para admin inicial)
OWNER_OPEN_ID=

# ============================================================================
# MANUS API (Forge/Storage)
# ============================================================================
# URL da API Manus (para storage, LLM, etc.)
MANUS_API_URL=https://api.manus.com

# API key para autenticação na API Manus
MANUS_API_KEY=your-manus-api-key

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Ambiente: development | production
NODE_ENV=development

# Porta do servidor (default: 3000)
PORT=3000

# ============================================================================
# OPTIONAL: MONITORING & LOGGING
# ============================================================================
# Sentry DSN para error tracking (opcional)
SENTRY_DSN=

# ============================================================================
# OPTIONAL: AWS S3 (se não usar Manus Storage)
# ============================================================================
# AWS Access Key ID
AWS_ACCESS_KEY_ID=

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=

# Nome do bucket S3
AWS_S3_BUCKET=

# Região AWS (ex: us-east-1)
AWS_REGION=

# ============================================================================
# OPTIONAL: CORS
# ============================================================================
# Origens permitidas (separadas por vírgula)
# Ex: https://vitta.com,https://www.vitta.com
ALLOWED_ORIGINS=
